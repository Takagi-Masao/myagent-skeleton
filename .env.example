# 复制为 .env，填自己的 key；不要提交 .env
MYAGENT_PROVIDER=dashscope
MYAGENT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MYAGENT_API_KEY=sk-REPLACE_ME
MYAGENT_MODEL=qwen3.8-flash

# 可选
# MYAGENT_MAX_STEPS=20
# MYAGENT_MAX_COST=0.5
# MYAGENT_MAX_SECONDS=300
# MYAGENT_TIMEOUT_S=120
# MYAGENT_PYTHON=
# MYAGENT_SHELL_BACKEND=auto

# 本地 OpenAI 兼容端点（llama.cpp / vLLM / Ollama）
# MYAGENT_PROVIDER=custom
# MYAGENT_BASE_URL=http://127.0.0.1:8081/v1
# MYAGENT_API_KEY=local
# MYAGENT_MODEL=/path/to/model.gguf
